{
  // Cloudflare Workers static site: serves the Vite build from ./dist at dragonvision.online.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragonvision",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
